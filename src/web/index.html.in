<!doctype html>
<html lang="{{html_lang}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{page_title}}</title>
  <!--link-preview:start-->
  <meta name="description" content="{{og_description}}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{page_title}}" />
  <meta property="og:locale" content="{{og_locale}}" />
  <meta property="og:title" content="{{page_title}}" />
  <meta property="og:description" content="{{og_description}}" />
  <meta name="twitter:card" content="summary" />
  <!--link-preview:end-->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v={{version:favicon.svg}}" />
  <link rel="stylesheet" href="/98.css?v={{version:98.css}}" />
  <link rel="stylesheet" href="/app.css?v={{version:app.css}}" />
</head>
<body
  data-weather-icons="/icons.svg?v={{version:icons.svg}}"
  data-http-error="{{http_error}}"
  data-memory-unavailable="{{memory_unavailable}}"
  data-imgw-unavailable="{{imgw_unavailable}}"
  data-location-denied="{{location_denied}}"
  data-location-unavailable="{{location_unavailable}}"
  data-forecast-unavailable="{{forecast_unavailable}}"
  data-forecast-cities-unavailable="{{forecast_cities_unavailable}}"
  data-forecast-nearest="{{forecast_nearest}}"
  data-favorite-add="{{favorite_add}}"
  data-favorite-remove="{{favorite_remove}}"
  data-favorites-unavailable="{{favorites_unavailable}}"
  data-favorites-full="{{favorites_full}}"
  data-account-invalid="{{account_invalid}}"
  data-account-limited="{{account_limited}}"
  data-account-unavailable="{{account_unavailable}}"
  data-account-signin-done="{{account_signin_done}}"
  data-account-signin-done-merged="{{account_signin_done_merged}}"
  data-account-copied="{{account_copied}}"
  data-wmo-clear="{{wmo_clear}}"
  data-wmo-partly="{{wmo_partly}}"
  data-wmo-cloudy="{{wmo_cloudy}}"
  data-wmo-fog="{{wmo_fog}}"
  data-wmo-drizzle="{{wmo_drizzle}}"
  data-wmo-rain="{{wmo_rain}}"
  data-wmo-showers="{{wmo_showers}}"
  data-wmo-snow="{{wmo_snow}}"
  data-wmo-thunderstorm="{{wmo_thunderstorm}}"
  data-imgw-search-placeholder="{{imgw_search_placeholder}}"
  data-imgw-warning-search-placeholder="{{imgw_warning_search_placeholder}}"
  data-imgw-warning-source-meteo="{{imgw_warning_source_meteo}}"
  data-imgw-warning-source-hydro="{{imgw_warning_source_hydro}}"
  data-imgw-warning-severity="{{imgw_warning_severity}}"
  data-imgw-storm-search-placeholder="{{imgw_storm_search_placeholder}}"
  data-imgw-storm-yes="{{imgw_storm_yes}}"
  data-imgw-storm-no="{{imgw_storm_no}}"
  data-imgw-storm-just-now="{{imgw_storm_just_now}}"
  data-imgw-storm-unavailable="{{imgw_storm_unavailable}}"
>
  <div
    class="window app-window"
    x-data="main_window"
    x-ref="mainWindow"
    :style="position ? `position: fixed; left: ${position.left}px; top: ${position.top}px` : ''"
  >
    <div
      class="title-bar"
      @pointerdown="start_drag"
      @pointermove="move_drag"
      @pointerup="end_drag"
      @pointercancel="end_drag"
    >
      <div class="title-bar-text">{{page_title}}</div>
    </div>
    <div class="window-body">
      <p class="language-switcher"><a href="/" lang="pl">PL</a> | <a href="/en/" lang="en">EN</a></p>
      <fieldset class="forecast-panel" x-data="forecast" @account-changed.window="load_favorites">
        <legend>{{forecast_legend}}</legend>
        <div class="forecast-combo" x-ref="combo" @focusout="leave">
          <label for="forecast-input">{{forecast_label}}</label>
          <div class="forecast-search">
            <input
              id="forecast-input"
              type="text"
              role="combobox"
              autocomplete="off"
              spellcheck="false"
              aria-autocomplete="list"
              aria-controls="forecast-list"
              :aria-expanded="list_visible ? 'true' : 'false'"
              :aria-activedescendant="active_option"
              placeholder="{{forecast_placeholder}}"
              x-model="query"
              @focus="focus_search"
              @input="on_input"
              @keydown="keydown"
            />
            <ul id="forecast-list" class="forecast-suggestions" role="listbox" x-show="list_visible" x-cloak>
              <template x-for="(city, index) in suggestions" :key="city.name + index">
                <li
                  role="option"
                  :id="`forecast-option-${index}`"
                  :aria-selected="index === active_index ? 'true' : 'false'"
                  :class="{ active: index === active_index }"
                  x-text="city.name"
                  @pointerdown.prevent="pick(city)"
                  @pointerenter="active_index = index"
                ></li>
              </template>
            </ul>
          </div>
          <p class="forecast-hint" x-show="no_results" x-cloak>{{forecast_no_results}}</p>
        </div>
        <div class="field-row forecast-actions">
          <button type="button" :disabled="locating" @click="locate">{{forecast_locate}}</button>
          <span class="imgw-status" x-show="locating" x-cloak>{{imgw_locating}}</span>
        </div>
        <div class="forecast-favorites" x-show="favorites.length > 0" x-cloak>
          <span id="forecast-favorites-label">{{favorites_label}}</span>
          <ul aria-labelledby="forecast-favorites-label">
            <template x-for="city in favorites" :key="city.name">
              <li><button type="button" x-text="city.name" @click="pick(city)"></button></li>
            </template>
          </ul>
        </div>
        <div aria-live="polite">
          <p class="imgw-status" x-show="loading" x-cloak>{{loading}}</p>
          <p class="imgw-status" x-show="status" x-cloak x-text="status"></p>
        </div>
        <div class="forecast-result" x-show="place && data" x-cloak>
          <div class="forecast-title">
            <h2 class="forecast-place" x-text="place?.label"></h2>
            <button
              type="button"
              class="forecast-star"
              x-show="place?.named"
              x-cloak
              :disabled="saving_favorite"
              :aria-label="favorite_label"
              :title="favorite_label"
              x-text="is_favorite ? '★' : '☆'"
              @click="toggle_favorite"
            ></button>
          </div>
          <menu role="tablist" aria-label="{{forecast_tabs_label}}">
            <li
              role="tab"
              id="forecast-tab-now"
              data-view="now"
              aria-controls="forecast-panel-now"
              :aria-selected="view === 'now' ? 'true' : 'false'"
              :tabindex="view === 'now' ? 0 : -1"
              @click="select_view('now')"
              @keydown.left.prevent="step_view(-1)"
              @keydown.right.prevent="step_view(1)"
            ><a href="#forecast-panel-now" @click.prevent>{{forecast_tab_now}}</a></li>
            <li
              role="tab"
              id="forecast-tab-days"
              data-view="days"
              aria-controls="forecast-panel-days"
              :aria-selected="view === 'days' ? 'true' : 'false'"
              :tabindex="view === 'days' ? 0 : -1"
              @click="select_view('days')"
              @keydown.left.prevent="step_view(-1)"
              @keydown.right.prevent="step_view(1)"
            ><a href="#forecast-panel-days" @click.prevent>{{forecast_tab_days}}</a></li>
            <li
              role="tab"
              id="forecast-tab-hours"
              data-view="hours"
              aria-controls="forecast-panel-hours"
              :aria-selected="view === 'hours' ? 'true' : 'false'"
              :tabindex="view === 'hours' ? 0 : -1"
              @click="select_view('hours')"
              @keydown.left.prevent="step_view(-1)"
              @keydown.right.prevent="step_view(1)"
            ><a href="#forecast-panel-hours" @click.prevent>{{forecast_tab_hours}}</a></li>
          </menu>
          <section
            class="window forecast-tab-body"
            id="forecast-panel-now"
            role="tabpanel"
            aria-labelledby="forecast-tab-now"
            x-show="view === 'now'"
          >
            <template x-if="now">
              <div>
                <p class="forecast-now">
                  <span class="forecast-icon" role="img" :aria-label="now.text" x-html="now.icon"></span>
                  <strong x-text="now.temperature"></strong>
                  <span x-text="now.text"></span>
                </p>
                <dl class="forecast-facts">
                  <dt>{{forecast_feels_like}}</dt>
                  <dd x-text="now.apparent"></dd>
                  <dt>{{forecast_humidity}}</dt>
                  <dd x-text="now.humidity"></dd>
                  <dt>{{forecast_wind}}</dt>
                  <dd x-text="now.wind"></dd>
                  <dt>{{forecast_precipitation}}</dt>
                  <dd x-text="now.precipitation"></dd>
                </dl>
              </div>
            </template>
          </section>
          <section
            class="window forecast-tab-body"
            id="forecast-panel-days"
            role="tabpanel"
            aria-labelledby="forecast-tab-days"
            x-show="view === 'days'"
            x-cloak
          >
            <table class="forecast-days">
              <thead>
                <tr>
                  <th scope="col">{{forecast_col_day}}</th>
                  <th scope="col">{{forecast_col_weather}}</th>
                  <th scope="col">{{forecast_col_range}}</th>
                  <th scope="col">{{forecast_col_rain}}</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="day in days" :key="day.date">
                  <tr>
                    <td x-text="day.label"></td>
                    <td><span class="forecast-day-icon" role="img" :aria-label="day.text" :title="day.text" x-html="day.icon"></span></td>
                    <td x-text="day.range"></td>
                    <td x-text="day.chance"></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </section>
          <section
            class="window forecast-tab-body"
            id="forecast-panel-hours"
            role="tabpanel"
            aria-labelledby="forecast-tab-hours"
            x-show="view === 'hours'"
            x-cloak
          >
            <div class="forecast-hours-scroll">
              <table class="forecast-hours">
                <thead>
                  <tr>
                    <th scope="col">{{forecast_col_hour}}</th>
                    <th scope="col">{{forecast_col_weather}}</th>
                    <th scope="col">{{forecast_col_temperature}}</th>
                    <th scope="col">{{forecast_col_rain}}</th>
                    <th scope="col">{{forecast_col_wind}}</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="(hour, index) in hours" :key="index">
                    <tr :class="{ 'day-start': hour.day }">
                      <td>
                        <span class="forecast-hour-day" x-show="hour.day" x-text="hour.day"></span>
                        <span x-text="hour.label"></span>
                      </td>
                      <td><span class="forecast-day-icon" role="img" :aria-label="hour.text" :title="hour.text" x-html="hour.icon"></span></td>
                      <td x-text="hour.temperature"></td>
                      <td x-text="hour.rain"></td>
                      <td x-text="hour.wind"></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </fieldset>
      <div class="imgw-panel" x-data="imgw" @keydown.escape.window="hide">
        <button
          type="button"
          x-ref="launcher"
          aria-haspopup="dialog"
          :aria-expanded="open ? 'true' : 'false'"
          @click="show"
        >{{imgw_button}}</button>
        <div
          class="modal-backdrop"
          x-show="open"
          x-cloak
          @pointerdown.self="press_backdrop"
          @pointerup.self="release_backdrop"
          @pointerup.window="pressed_backdrop = false"
        >
          <div
            class="window imgw-window"
            x-ref="dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="imgw-title"
            :style="`transform: translate(${offset.x}px, ${offset.y}px)`"
            @pointerdown="pressed_backdrop = false"
          >
            <div
              class="title-bar"
              @pointerdown="start_drag"
              @pointermove="move_drag"
              @pointerup="end_drag"
              @pointercancel="end_drag"
            >
              <div class="title-bar-text" id="imgw-title">{{imgw_title}}</div>
              <div class="title-bar-controls">
                <button type="button" class="close" x-ref="closeButton" aria-label="{{close}}" @click="hide"></button>
              </div>
            </div>
            <div class="window-body">
              <menu role="tablist" aria-label="{{imgw_title}}">
                <li
                  role="tab"
                  id="imgw-tab-synop"
                  data-tab="synop"
                  :aria-selected="tab === 'synop' ? 'true' : 'false'"
                  :tabindex="tab === 'synop' ? 0 : -1"
                  @click="select('synop')"
                  @keydown.left.prevent="step(-1)"
                  @keydown.right.prevent="step(1)"
                ><a href="#imgw-panel" @click.prevent>{{imgw_tab_synop}}</a></li>
                <li
                  role="tab"
                  id="imgw-tab-hydro"
                  data-tab="hydro"
                  :aria-selected="tab === 'hydro' ? 'true' : 'false'"
                  :tabindex="tab === 'hydro' ? 0 : -1"
                  @click="select('hydro')"
                  @keydown.left.prevent="step(-1)"
                  @keydown.right.prevent="step(1)"
                ><a href="#imgw-panel" @click.prevent>{{imgw_tab_hydro}}</a></li>
                <li
                  role="tab"
                  id="imgw-tab-meteo"
                  data-tab="meteo"
                  :aria-selected="tab === 'meteo' ? 'true' : 'false'"
                  :tabindex="tab === 'meteo' ? 0 : -1"
                  @click="select('meteo')"
                  @keydown.left.prevent="step(-1)"
                  @keydown.right.prevent="step(1)"
                ><a href="#imgw-panel" @click.prevent>{{imgw_tab_meteo}}</a></li>
                <li
                  role="tab"
                  id="imgw-tab-warnings"
                  data-tab="warnings"
                  :aria-selected="tab === 'warnings' ? 'true' : 'false'"
                  :tabindex="tab === 'warnings' ? 0 : -1"
                  @click="select('warnings')"
                  @keydown.left.prevent="step(-1)"
                  @keydown.right.prevent="step(1)"
                ><a href="#imgw-panel" @click.prevent>{{imgw_tab_warnings}}</a></li>
                <li
                  role="tab"
                  id="imgw-tab-storm"
                  data-tab="storm"
                  :aria-selected="tab === 'storm' ? 'true' : 'false'"
                  :tabindex="tab === 'storm' ? 0 : -1"
                  @click="select('storm')"
                  @keydown.left.prevent="step(-1)"
                  @keydown.right.prevent="step(1)"
                ><a href="#imgw-panel" @click.prevent>{{imgw_tab_storm}}</a></li>
              </menu>
              <section
                class="window imgw-tab-body"
                id="imgw-panel"
                role="tabpanel"
                :aria-labelledby="`imgw-tab-${tab}`"
              >
                <div class="field-row imgw-search">
                  <label :for="`imgw-search-${tab}`">{{imgw_search}}</label>
                  <input
                    type="search"
                    class="imgw-search-input"
                    :id="`imgw-search-${tab}`"
                    x-ref="search"
                    x-model="query[tab]"
                    :placeholder="search_placeholder"
                  />
                  <button
                    type="button"
                    class="imgw-clear"
                    :disabled="query[tab].length === 0"
                    aria-label="{{imgw_clear}}"
                    title="{{imgw_clear}}"
                    @click="clear_search"
                  >×</button>
                </div>
                <div class="imgw-stations" x-show="tab !== 'warnings' && tab !== 'storm'">
                  <div class="field-row imgw-nearby">
                    <button
                      type="button"
                      x-show="nearby_supported"
                      x-cloak
                      :aria-pressed="nearby ? 'true' : 'false'"
                      :disabled="locating"
                      @click="toggle_nearby"
                    >
                      <span x-show="!nearby">{{imgw_nearby}}</span>
                      <span x-show="nearby" x-cloak>{{imgw_nearby_off}}</span>
                    </button>
                    <span
                      class="imgw-nearby-hint"
                      x-show="active.items && !nearby_supported"
                      x-cloak
                    >{{imgw_nearby_unsupported}}</span>
                    <span class="imgw-status" x-show="locating" x-cloak>{{imgw_locating}}</span>
                    <span
                      class="imgw-status"
                      x-show="location_error"
                      x-cloak
                      x-text="location_error"
                    ></span>
                  </div>
                  <p class="imgw-status" x-show="active.loading" x-cloak>{{loading}}</p>
                  <p class="imgw-status" x-show="active.error" x-cloak x-text="active.error"></p>
                  <p class="imgw-count" x-show="!active.loading && !active.error" x-cloak>
                    {{imgw_count}} <span x-text="filtered.length"></span>
                  </p>
                  <label class="imgw-list-label" for="imgw-list-stations">
                    <span x-show="!nearby || !nearby_supported">{{imgw_list}}</span>
                    <span x-show="nearby && nearby_supported" x-cloak>{{imgw_nearby_list}}</span>
                  </label>
                  <select class="imgw-list" id="imgw-list-stations" multiple size="12" @change="pick">
                    <template x-for="station in filtered" :key="station.key">
                      <option :value="station.key" x-text="describe(station)"></option>
                    </template>
                  </select>
                  <p
                    class="imgw-status"
                    x-show="!active.loading && !active.error && filtered.length === 0"
                    x-cloak
                  >{{imgw_empty}}</p>
                  <p class="imgw-status" x-show="!active.selected && !active.loading" x-cloak>{{imgw_no_selection}}</p>
                  <div class="imgw-details" x-show="active.selected" x-cloak>
                    <h3 class="imgw-details-title">{{imgw_details}}</h3>
                    <p class="imgw-status" x-show="active.detail_loading" x-cloak>{{loading}}</p>
                    <p class="imgw-status" x-show="active.detail_error" x-cloak x-text="active.detail_error"></p>
                    <dl
                      class="imgw-detail-list"
                      x-show="active.kind === 'weather' && active.detail"
                      x-cloak
                    >
                      <dt>{{imgw_station_id}}</dt>
                      <dd x-text="format_value(active.detail?.station_id)"></dd>
                      <dt>{{imgw_station_name}}</dt>
                      <dd x-text="format_value(active.detail?.station_name)"></dd>
                      <dt>{{imgw_observed_at}}</dt>
                      <dd x-text="format_value(active.detail?.observed_at)"></dd>
                      <dt>{{imgw_temperature}}</dt>
                      <dd x-text="format_value(active.detail?.temperature_c, '°C')"></dd>
                      <dt>{{imgw_wind_speed}}</dt>
                      <dd x-text="format_value(active.detail?.wind_speed_m_s, 'm/s')"></dd>
                      <dt>{{imgw_wind_direction}}</dt>
                      <dd x-text="format_value(active.detail?.wind_direction_deg, '°')"></dd>
                      <dt>{{imgw_humidity}}</dt>
                      <dd x-text="format_value(active.detail?.relative_humidity_percent, '%')"></dd>
                      <dt>{{imgw_precipitation}}</dt>
                      <dd x-text="format_value(active.detail?.precipitation_mm, 'mm')"></dd>
                      <dt>{{imgw_pressure}}</dt>
                      <dd x-text="format_value(active.detail?.pressure_hpa, 'hPa')"></dd>
                      <template x-if="active.detail?.latitude != null">
                        <dt>{{imgw_coordinates}}</dt>
                      </template>
                      <template x-if="active.detail?.latitude != null">
                        <dd x-text="coordinates(active.detail)"></dd>
                      </template>
                    </dl>
                    <dl
                      class="imgw-detail-list"
                      x-show="active.kind === 'hydro' && active.detail"
                      x-cloak
                    >
                      <dt>{{imgw_station_id}}</dt>
                      <dd x-text="format_value(active.detail?.station_id)"></dd>
                      <dt>{{imgw_station_name}}</dt>
                      <dd x-text="format_value(active.detail?.station_name)"></dd>
                      <dt>{{imgw_river}}</dt>
                      <dd x-text="format_value(active.detail?.river)"></dd>
                      <dt>{{imgw_voivodeship}}</dt>
                      <dd x-text="format_value(active.detail?.voivodeship)"></dd>
                      <dt>{{imgw_water_level}}</dt>
                      <dd x-text="format_value(active.detail?.water_level_cm, 'cm')"></dd>
                      <dt>{{imgw_water_level_status}}</dt>
                      <dd x-text="format_value(active.detail?.water_level_status)"></dd>
                      <dt>{{imgw_water_level_at}}</dt>
                      <dd x-text="format_value(active.detail?.water_level_observed_at)"></dd>
                      <dt>{{imgw_water_temperature}}</dt>
                      <dd x-text="format_value(active.detail?.water_temperature_c, '°C')"></dd>
                      <dt>{{imgw_flow}}</dt>
                      <dd x-text="format_value(active.detail?.flow_m3_s, 'm³/s')"></dd>
                      <dt>{{imgw_warning_level}}</dt>
                      <dd x-text="format_value(active.detail?.warning_level_cm, 'cm')"></dd>
                      <dt>{{imgw_alarm_level}}</dt>
                      <dd x-text="format_value(active.detail?.alarm_level_cm, 'cm')"></dd>
                      <dt>{{imgw_gauge_zero}}</dt>
                      <dd x-text="format_value(active.detail?.gauge_zero_m, 'm')"></dd>
                      <dt>{{imgw_river_km}}</dt>
                      <dd x-text="format_value(active.detail?.river_km, 'km')"></dd>
                      <dt>{{imgw_coordinates}}</dt>
                      <dd x-text="coordinates(active.detail)"></dd>
                      <dt>{{imgw_founded_year}}</dt>
                      <dd x-text="format_value(active.detail?.founded_year)"></dd>
                      <dt>{{imgw_ice_phenomenon}}</dt>
                      <dd x-text="format_value(active.detail?.ice_phenomenon)"></dd>
                      <dt>{{imgw_overgrowth_phenomenon}}</dt>
                      <dd x-text="format_value(active.detail?.overgrowth_phenomenon)"></dd>
                    </dl>
                  </div>
                </div>
                <div class="imgw-warnings" x-show="tab === 'warnings'" x-cloak>
                  <div class="field-row imgw-warning-source">
                    <label for="imgw-warning-source">{{imgw_warning_source_filter}}</label>
                    <select id="imgw-warning-source" x-model="source_filter">
                      <option value="">{{imgw_warning_source_all}}</option>
                      <option value="meteo">{{imgw_warning_source_meteo}}</option>
                      <option value="hydro">{{imgw_warning_source_hydro}}</option>
                    </select>
                  </div>
                  <p class="imgw-status" x-show="active.loading" x-cloak>{{loading}}</p>
                  <p class="imgw-status" x-show="active.error" x-cloak x-text="active.error"></p>
                  <p class="imgw-count" x-show="!active.loading && !active.error" x-cloak>
                    {{imgw_warning_count}} <span x-text="filtered.length"></span>
                  </p>
                  <label class="imgw-list-label" for="imgw-list-warnings">{{imgw_warning_list}}</label>
                  <select class="imgw-list" id="imgw-list-warnings" multiple size="12" @change="pick">
                    <template x-for="warning in filtered" :key="warning.key">
                      <option :value="warning.key" x-text="describe(warning)"></option>
                    </template>
                  </select>
                  <p
                    class="imgw-status"
                    x-show="!active.loading && !active.error && (active.items ?? []).length === 0"
                    x-cloak
                  >{{imgw_warning_empty_all}}</p>
                  <p
                    class="imgw-status"
                    x-show="!active.loading && !active.error && (active.items ?? []).length > 0 && filtered.length === 0"
                    x-cloak
                  >{{imgw_warning_empty_filter}}</p>
                  <p class="imgw-status" x-show="!active.selected && !active.loading" x-cloak>{{imgw_warning_no_selection}}</p>
                  <div class="imgw-details" x-show="active.selected" x-cloak>
                    <h3 class="imgw-details-title">
                      <span x-text="format_value(active.detail?.event)"></span>
                      <span
                        class="imgw-warning-badge"
                        :class="severity_class(active.detail)"
                        x-text="severity_label(active.detail)"
                      ></span>
                    </h3>
                    <dl class="imgw-detail-list">
                      <dt>{{imgw_warning_source}}</dt>
                      <dd x-text="source_label(active.detail)"></dd>
                      <dt>{{imgw_warning_severity}}</dt>
                      <dd x-text="severity_label(active.detail)"></dd>
                      <dt>{{imgw_warning_probability}}</dt>
                      <dd x-text="format_value(active.detail?.probability_percent, '%')"></dd>
                      <dt>{{imgw_warning_valid_from}}</dt>
                      <dd x-text="format_value(active.detail?.effective_from)"></dd>
                      <dt>{{imgw_warning_valid_to}}</dt>
                      <dd x-text="format_value(active.detail?.effective_to)"></dd>
                      <dt>{{imgw_warning_office}}</dt>
                      <dd x-text="format_value(active.detail?.office)"></dd>
                      <dt>{{imgw_warning_published}}</dt>
                      <dd x-text="format_value(active.detail?.published_at)"></dd>
                    </dl>
                    <h4 class="imgw-warning-heading">{{imgw_warning_content}}</h4>
                    <p class="imgw-warning-text" x-text="format_value(active.detail?.content)"></p>
                    <template x-if="active.detail?.comment">
                      <div>
                        <h4 class="imgw-warning-heading">{{imgw_warning_comment}}</h4>
                        <p class="imgw-warning-text" x-text="active.detail.comment"></p>
                      </div>
                    </template>
                    <h4 class="imgw-warning-heading">{{imgw_warning_areas}}</h4>
                    <ul class="imgw-warning-areas" x-show="warning_areas(active.detail).length > 0">
                      <template x-for="(area, index) in warning_areas(active.detail)" :key="index">
                        <li x-text="area"></li>
                      </template>
                    </ul>
                    <p
                      class="imgw-status"
                      x-show="warning_areas(active.detail).length === 0"
                    >{{imgw_warning_no_areas}}</p>
                  </div>
                </div>
                <div class="imgw-storm" x-show="tab === 'storm'" x-cloak>
                  <p class="imgw-status" x-show="active.loading" x-cloak>{{loading}}</p>
                  <p class="imgw-status" x-show="active.error" x-cloak x-text="active.error"></p>
                  <p class="imgw-count" x-show="!active.loading && !active.error" x-cloak>
                    {{imgw_storm_count}} <span x-text="filtered.length"></span>
                  </p>
                  <label class="imgw-list-label" for="imgw-list-storm">{{imgw_storm_list}}</label>
                  <select class="imgw-list" id="imgw-list-storm" multiple size="12" @change="pick">
                    <template x-for="city in filtered" :key="city.key">
                      <option :value="city.key" x-text="describe(city)"></option>
                    </template>
                  </select>
                  <p
                    class="imgw-status"
                    x-show="!active.loading && !active.error && filtered.length === 0"
                    x-cloak
                  >{{imgw_storm_empty}}</p>
                  <div class="field-row imgw-storm-fetch">
                    <button
                      type="button"
                      :disabled="!active.selected || active.detail_loading"
                      @click="load_storm"
                    >{{imgw_storm_fetch}}</button>
                    <span
                      class="imgw-status"
                      x-show="!active.selected && !active.loading"
                      x-cloak
                    >{{imgw_storm_no_selection}}</span>
                  </div>
                  <div class="imgw-details" x-show="active.selected" x-cloak>
                    <h3 class="imgw-details-title">
                      {{imgw_storm_detail}} <span x-text="format_value(active.selected?.city_name)"></span>
                    </h3>
                    <p class="imgw-status" x-show="active.detail_loading" x-cloak>{{loading}}</p>
                    <p class="imgw-status" x-show="active.detail_error" x-cloak x-text="active.detail_error"></p>
                    <dl class="imgw-detail-list" x-show="active.detail" x-cloak>
                      <dt>{{imgw_storm_city_id}}</dt>
                      <dd x-text="format_value(active.detail?.city_id)"></dd>
                      <dt>{{imgw_storm_city_name}}</dt>
                      <dd x-text="format_value(active.detail?.city_name)"></dd>
                      <dt>{{imgw_storm_probability}}</dt>
                      <dd x-text="format_value(active.detail?.storm_probability, '%')"></dd>
                      <dt>{{imgw_storm_minutes}}</dt>
                      <dd x-text="format_storm_minutes(active.detail?.storm_minutes)"></dd>
                      <dt>{{imgw_storm_alarm}}</dt>
                      <dd x-text="active.detail ? format_flag(active.detail.storm_alarm) : '—'"></dd>
                      <dt>{{imgw_storm_rain_probability}}</dt>
                      <dd x-text="format_value(active.detail?.rain_probability, '%')"></dd>
                      <dt>{{imgw_storm_rain_minutes}}</dt>
                      <dd x-text="format_storm_minutes(active.detail?.rain_minutes)"></dd>
                      <dt>{{imgw_storm_rain_alarm}}</dt>
                      <dd x-text="active.detail ? format_flag(active.detail.rain_alarm) : '—'"></dd>
                      <dt>{{imgw_storm_active}}</dt>
                      <dd x-text="format_value(active.detail?.active_storm)"></dd>
                      <dt>{{imgw_coordinates}}</dt>
                      <dd x-text="coordinates(active.detail)"></dd>
                      <dt>{{imgw_storm_fetched}}</dt>
                      <dd x-text="describe_age(active.detail)"></dd>
                    </dl>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>
      </div>
      <div class="launcher-row">
        <div class="account-panel" x-data="account" @keydown.escape.window="hide">
          <button
            type="button"
            x-ref="launcher"
            aria-haspopup="dialog"
            :aria-expanded="open ? 'true' : 'false'"
            @click="show"
          >{{account_button}}</button>
          <div
            class="modal-backdrop"
            x-show="open"
            x-cloak
            @pointerdown.self="press_backdrop"
            @pointerup.self="release_backdrop"
            @pointerup.window="pressed_backdrop = false"
          >
            <div
              class="window account-window"
              x-ref="dialog"
              role="dialog"
              aria-modal="true"
              aria-labelledby="account-title"
              :style="`transform: translate(${offset.x}px, ${offset.y}px)`"
              @pointerdown="pressed_backdrop = false"
            >
              <div
                class="title-bar"
                @pointerdown="start_drag"
                @pointermove="move_drag"
                @pointerup="end_drag"
                @pointercancel="end_drag"
              >
                <div class="title-bar-text" id="account-title">{{account_title}}</div>
                <div class="title-bar-controls">
                  <button type="button" class="close" x-ref="closeButton" aria-label="{{close}}" @click="hide"></button>
                </div>
              </div>
              <div class="window-body">
                <p class="account-intro">{{account_intro}}</p>
                <p class="account-intro" x-show="!session" x-cloak>{{account_none}}</p>
                <fieldset x-show="session" x-cloak>
                  <legend>{{account_transfer_legend}}</legend>
                  <div x-show="transfer" x-cloak>
                    <output class="account-code" x-text="transfer?.code"></output>
                    <p class="account-note">{{account_transfer_note}} {{account_transfer_left}}: <span x-text="remaining_text"></span></p>
                    <button type="button" x-show="clipboard" x-cloak @click="copy(transfer.code)">{{account_copy}}</button>
                  </div>
                  <button type="button" x-show="!transfer" :disabled="busy" @click="show_transfer">{{account_transfer_show}}</button>
                </fieldset>
                <fieldset x-show="session" x-cloak>
                  <legend>{{account_recovery_legend}}</legend>
                  <p class="account-note">
                    <span x-show="has_recovery" x-cloak>{{account_recovery_set}}</span>
                    <span x-show="!has_recovery" x-cloak>{{account_recovery_unset}}</span>
                    {{account_recovery_note}}
                  </p>
                  <div x-show="recovery" x-cloak>
                    <output class="account-code" x-text="recovery"></output>
                    <p class="account-note account-warning">{{account_recovery_once}}</p>
                    <button type="button" x-show="clipboard" x-cloak @click="copy(recovery)">{{account_copy}}</button>
                  </div>
                  <button type="button" :disabled="busy" @click="make_recovery">
                    <span x-show="!has_recovery" x-cloak>{{account_recovery_make}}</span>
                    <span x-show="has_recovery" x-cloak>{{account_recovery_replace}}</span>
                  </button>
                </fieldset>
                <fieldset>
                  <legend>{{account_signin_legend}}</legend>
                  <div class="field-row-stacked">
                    <label for="account-code">{{account_signin_label}}</label>
                    <input
                      id="account-code"
                      type="text"
                      autocomplete="off"
                      autocapitalize="characters"
                      spellcheck="false"
                      maxlength="40"
                      x-model="code"
                      @keydown.enter.prevent="sign_in"
                    />
                  </div>
                  <p class="account-note" x-show="has_favorites" x-cloak>{{account_signin_merge}}</p>
                  <button type="button" :disabled="busy || code.trim() === ''" @click="sign_in">{{account_signin_button}}</button>
                </fieldset>
                <p class="account-message" aria-live="polite" x-show="message" x-cloak :class="{ failed }" x-text="message"></p>
                <div class="field-row account-actions">
                  <button type="button" x-show="session" x-cloak :disabled="busy" @click="sign_out">{{account_signout}}</button>
                  <button type="button" @click="hide">{{close}}</button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="about-panel" x-data="about" @keydown.escape.window="hide">
        <button
          type="button"
          x-ref="launcher"
          aria-haspopup="dialog"
          :aria-expanded="open ? 'true' : 'false'"
          @click="show"
        >{{about_button}}</button>
        <div
          class="modal-backdrop"
          x-show="open"
          x-cloak
          @pointerdown.self="press_backdrop"
          @pointerup.self="release_backdrop"
          @pointerup.window="pressed_backdrop = false"
        >
          <div
            class="window about-window"
            x-ref="dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="about-title"
            :style="`transform: translate(${offset.x}px, ${offset.y}px)`"
            @pointerdown="pressed_backdrop = false"
          >
            <div
              class="title-bar"
              @pointerdown="start_drag"
              @pointermove="move_drag"
              @pointerup="end_drag"
              @pointercancel="end_drag"
            >
              <div class="title-bar-text" id="about-title">{{about_title}}</div>
              <div class="title-bar-controls">
                <button type="button" class="close" x-ref="closeButton" aria-label="{{close}}" @click="hide"></button>
              </div>
            </div>
            <div class="window-body">
              <p>{{about_body}}</p>
              <p class="about-attribution">{{about_source}}</p>
              <p class="about-attribution">{{about_processed}}</p>
              <p class="about-attribution">{{about_antistorm}} (<a href="https://antistorm.eu/" rel="noopener noreferrer">https://antistorm.eu/</a>).</p>
              <p class="about-attribution">{{about_openmeteo}} (<a href="https://open-meteo.com/" rel="noopener noreferrer">https://open-meteo.com/</a>).</p>
              <fieldset class="memory-panel">
                <legend>{{memory_title}}</legend>
                <p class="memory-status" x-show="loading" x-cloak>{{loading}}</p>
                <p class="memory-status" x-show="error" x-cloak x-text="error"></p>
                <dl class="memory-stats" x-show="usage" x-cloak>
                  <dt>{{memory_own}}</dt>
                  <dd x-text="format_bytes(usage?.own_bytes)"></dd>
                  <dt>{{memory_rss}}</dt>
                  <dd x-text="format_bytes(usage?.rss_bytes)"></dd>
                </dl>
                <p class="memory-note">{{memory_note}}</p>
                <button type="button" @click="load" :disabled="loading">{{memory_refresh}}</button>
              </fieldset>
              <div class="field-row about-actions">
                <button type="button" @click="hide">{{close}}</button>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </div>
  </div>

  <script defer src="/app.js?v={{version:app.js}}"></script>
  <script defer src="/qrcode.js?v={{version:qrcode.js}}"></script>
  <script defer src="/alpine.js?v={{version:alpine.js}}"></script>
</body>
</html>
