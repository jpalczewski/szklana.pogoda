<!doctype html>
<html lang="{{ html_lang }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ page_title }}</title>
  <!--link-preview:start-->
  <meta name="description" content="{{ og_description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ page_title }}" />
  <meta property="og:locale" content="{{ og_locale }}" />
  <meta property="og:title" content="{{ page_title }}" />
  <meta property="og:description" content="{{ og_description }}" />
  <meta name="twitter:card" content="summary" />
  <!--link-preview:end-->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v={{ version:favicon.svg }}" />
  <link rel="preload" href="/pixelated-ms-sans-serif.woff2?v={{ version:pixelated-ms-sans-serif.woff2 }}" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/pixelated-ms-sans-serif-bold.woff2?v={{ version:pixelated-ms-sans-serif-bold.woff2 }}" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/98.css?v={{ version:98.css }}" />
  <link rel="stylesheet" href="/app.css?v={{ version:app.css }}" />
</head>
<body
  data-weather-icons="/icons.svg?v={{ version:icons.svg }}"
  {#
    Each key becomes `data-<key>` with its dashes: `http_error` is read as
    `document.body.dataset.httpError`.
  #}
  {% dataset
    http_error, memory_unavailable,
    imgw_unavailable,
    location_denied, location_unavailable,
    forecast_unavailable, forecast_cities_unavailable, forecast_nearest,
    favorite_add, favorite_remove, favorites_unavailable, favorites_full,
    account_invalid, account_limited, account_unavailable,
    account_signin_done, account_signin_done_merged, account_copied,
    wmo_clear, wmo_partly, wmo_cloudy, wmo_fog, wmo_drizzle,
    wmo_rain, wmo_showers, wmo_snow, wmo_thunderstorm,
    imgw_search_placeholder, imgw_warning_search_placeholder,
    imgw_warning_source_meteo, imgw_warning_source_hydro, imgw_warning_severity,
    imgw_storm_search_placeholder, imgw_storm_yes, imgw_storm_no, imgw_storm_just_now, imgw_storm_unavailable
  %}
>
  <div
    class="window app-window"
    x-data="main_window"
    x-ref="mainWindow"
    :style="position ? `position: fixed; left: ${position.left}px; top: ${position.top}px` : ''"
  >
    <div
      class="title-bar"
      @pointerdown="start_drag"
      @pointermove="move_drag"
      @pointerup="end_drag"
      @pointercancel="end_drag"
    >
      <div class="title-bar-text">{{ page_title }}</div>
    </div>
    <div class="window-body">
      <p class="language-switcher"><a href="/" lang="pl">PL</a> | <a href="/en/" lang="en">EN</a></p>
      {% include "forecast" %}
      {% include "imgw" %}
      <div class="launcher-row">
        {% include "account" %}
        {% include "about" %}
      </div>
    </div>
  </div>

  <script defer src="/arrival.js?v={{ version:arrival.js }}"></script>
  <script defer src="/lib.js?v={{ version:lib.js }}"></script>
  <script defer src="/windows.js?v={{ version:windows.js }}"></script>
  <script defer src="/account.js?v={{ version:account.js }}"></script>
  <script defer src="/imgw.js?v={{ version:imgw.js }}"></script>
  <script defer src="/forecast.js?v={{ version:forecast.js }}"></script>
  <script defer src="/app.js?v={{ version:app.js }}"></script>
  <script defer src="/qrcode.js?v={{ version:qrcode.js }}"></script>
  <script defer src="/alpine.js?v={{ version:alpine.js }}"></script>
</body>
</html>
