<!doctype html>
<html lang="{{ html_lang }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ page_title }}</title>
  <!--link-preview:start-->
  <meta name="description" content="{{ og_description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ page_title }}" />
  <meta property="og:locale" content="{{ og_locale }}" />
  <meta property="og:title" content="{{ page_title }}" />
  <meta property="og:description" content="{{ og_description }}" />
  <meta name="twitter:card" content="summary" />
  <!--link-preview:end-->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v={{ version:favicon.svg }}" />
  <link rel="stylesheet" href="/98.css?v={{ version:98.css }}" />
  <link rel="stylesheet" href="/app.css?v={{ version:app.css }}" />
</head>
<body
  data-weather-icons="/icons.svg?v={{ version:icons.svg }}"
  data-http-error="{{ http_error }}"
  data-memory-unavailable="{{ memory_unavailable }}"
  data-imgw-unavailable="{{ imgw_unavailable }}"
  data-location-denied="{{ location_denied }}"
  data-location-unavailable="{{ location_unavailable }}"
  data-forecast-unavailable="{{ forecast_unavailable }}"
  data-forecast-cities-unavailable="{{ forecast_cities_unavailable }}"
  data-forecast-nearest="{{ forecast_nearest }}"
  data-favorite-add="{{ favorite_add }}"
  data-favorite-remove="{{ favorite_remove }}"
  data-favorites-unavailable="{{ favorites_unavailable }}"
  data-favorites-full="{{ favorites_full }}"
  data-account-invalid="{{ account_invalid }}"
  data-account-limited="{{ account_limited }}"
  data-account-unavailable="{{ account_unavailable }}"
  data-account-signin-done="{{ account_signin_done }}"
  data-account-signin-done-merged="{{ account_signin_done_merged }}"
  data-account-copied="{{ account_copied }}"
  data-wmo-clear="{{ wmo_clear }}"
  data-wmo-partly="{{ wmo_partly }}"
  data-wmo-cloudy="{{ wmo_cloudy }}"
  data-wmo-fog="{{ wmo_fog }}"
  data-wmo-drizzle="{{ wmo_drizzle }}"
  data-wmo-rain="{{ wmo_rain }}"
  data-wmo-showers="{{ wmo_showers }}"
  data-wmo-snow="{{ wmo_snow }}"
  data-wmo-thunderstorm="{{ wmo_thunderstorm }}"
  data-imgw-search-placeholder="{{ imgw_search_placeholder }}"
  data-imgw-warning-search-placeholder="{{ imgw_warning_search_placeholder }}"
  data-imgw-warning-source-meteo="{{ imgw_warning_source_meteo }}"
  data-imgw-warning-source-hydro="{{ imgw_warning_source_hydro }}"
  data-imgw-warning-severity="{{ imgw_warning_severity }}"
  data-imgw-storm-search-placeholder="{{ imgw_storm_search_placeholder }}"
  data-imgw-storm-yes="{{ imgw_storm_yes }}"
  data-imgw-storm-no="{{ imgw_storm_no }}"
  data-imgw-storm-just-now="{{ imgw_storm_just_now }}"
  data-imgw-storm-unavailable="{{ imgw_storm_unavailable }}"
>
  <div
    class="window app-window"
    x-data="main_window"
    x-ref="mainWindow"
    :style="position ? `position: fixed; left: ${position.left}px; top: ${position.top}px` : ''"
  >
    <div
      class="title-bar"
      @pointerdown="start_drag"
      @pointermove="move_drag"
      @pointerup="end_drag"
      @pointercancel="end_drag"
    >
      <div class="title-bar-text">{{ page_title }}</div>
    </div>
    <div class="window-body">
      <p class="language-switcher"><a href="/" lang="pl">PL</a> | <a href="/en/" lang="en">EN</a></p>
      {% include "forecast" %}
      {% include "imgw" %}
      <div class="launcher-row">
        {% include "account" %}
        {% include "about" %}
      </div>
    </div>
  </div>

  <script defer src="/arrival.js?v={{ version:arrival.js }}"></script>
  <script defer src="/lib.js?v={{ version:lib.js }}"></script>
  <script defer src="/windows.js?v={{ version:windows.js }}"></script>
  <script defer src="/account.js?v={{ version:account.js }}"></script>
  <script defer src="/imgw.js?v={{ version:imgw.js }}"></script>
  <script defer src="/forecast.js?v={{ version:forecast.js }}"></script>
  <script defer src="/app.js?v={{ version:app.js }}"></script>
  <script defer src="/qrcode.js?v={{ version:qrcode.js }}"></script>
  <script defer src="/alpine.js?v={{ version:alpine.js }}"></script>
</body>
</html>
