<!doctype html>
<html lang="{{html_lang}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{page_title}}</title>
  <link rel="stylesheet" href="/98.css" />
  <link rel="stylesheet" href="/app.css" />
</head>
<body
  data-loading="{{loading}}"
  data-http-error="{{http_error}}"
  data-connection-error="{{connection_error}}"
  data-memory-unavailable="{{memory_unavailable}}"
>
  <div class="window app-window">
    <div class="title-bar">
      <div class="title-bar-text">{{page_title}}</div>
    </div>
    <div class="window-body">
      <p class="language-switcher"><a href="/" lang="pl">PL</a> | <a href="/en/" lang="en">EN</a></p>
      <p>{{intro}}</p>
      <button id="ping-button">{{ping_button}}</button>
      <fieldset class="memory-panel" x-data="memory" x-init="load">
        <legend>{{memory_title}}</legend>
        <p class="memory-status" x-show="loading" x-cloak>{{loading}}</p>
        <p class="memory-status" x-show="error" x-cloak x-text="error"></p>
        <dl class="memory-stats" x-show="usage" x-cloak>
          <dt>{{memory_rss}}</dt>
          <dd x-text="format_bytes(usage?.rss_bytes)"></dd>
          <dt>{{memory_virtual}}</dt>
          <dd x-text="format_bytes(usage?.virtual_memory_bytes)"></dd>
        </dl>
        <button type="button" @click="load" :disabled="loading">{{memory_refresh}}</button>
      </fieldset>
    </div>
    <div class="status-bar">
      <p class="status-bar-field" id="pong">{{ready}}</p>
    </div>
  </div>

  <script defer src="/app.js"></script>
  <script defer src="/alpine.js"></script>
</body>
</html>
