{# The account dialog: sign-in codes, recovery and sign-out. #}
{% call "dialog" name=account title="{{ account_title }}" button="{{ account_button }}"
  attrs='@hashchange.window="arrive_from_address"' %}
  <fieldset class="account-arrival" x-show="pending" x-cloak>
    <legend>{{ account_arrival_legend }}</legend>
    <p class="account-note">{{ account_arrival_body }}</p>
    <p class="account-note" x-show="favorites_count > 0" x-cloak>
      {{ account_arrival_joined }} <strong x-text="favorites_count"></strong>
    </p>
    <div class="field-row account-arrival-actions">
      <button type="button" x-ref="cancel" @click="cancel_arrival">{{ account_arrival_cancel }}</button>
      <button type="button" :disabled="busy" @click="confirm_arrival">{{ account_arrival_confirm }}</button>
    </div>
  </fieldset>
  <p class="account-intro" x-show="!pending" x-cloak>{{ account_intro }}</p>
  <p class="account-intro" x-show="!session && !pending" x-cloak>{{ account_none }}</p>
  <fieldset x-show="session && !pending" x-cloak>
    <legend>{{ account_transfer_legend }}</legend>
    <div x-show="transfer" x-cloak>
      <output class="account-code" x-text="transfer?.code"></output>
      <div class="account-qr" x-show="qr" x-cloak role="img" aria-label="{{ account_qr_label }}">
        <svg aria-hidden="true" focusable="false" :view-box.camel="qr?.view_box">
          <rect x="0" y="0" :width="qr?.side" :height="qr?.side" fill="#fff" />
          <path :d="qr?.path" fill="#000" shape-rendering="crispEdges" />
        </svg>
      </div>
      <p class="account-note">{{ account_transfer_note }} {{ account_transfer_left }}: <span x-text="remaining_text"></span></p>
      <p class="account-note" x-show="qr" x-cloak>{{ account_qr_note }}</p>
      <div class="field-row account-copy">
        <button type="button" x-show="clipboard" x-cloak @click="copy(transfer.code)">{{ account_copy }}</button>
        <button type="button" x-show="clipboard" x-cloak @click="copy(link)">{{ account_copy_link }}</button>
        <button type="button" @click="drop_transfer">{{ account_hide }}</button>
      </div>
    </div>
    <button type="button" x-show="!transfer" :disabled="busy" @click="show_transfer">{{ account_transfer_show }}</button>
  </fieldset>
  <fieldset x-show="session && !pending" x-cloak>
    <legend>{{ account_recovery_legend }}</legend>
    <p class="account-note">
      <span x-show="has_recovery" x-cloak>{{ account_recovery_set }}</span>
      <span x-show="!has_recovery" x-cloak>{{ account_recovery_unset }}</span>
      {{ account_recovery_note }}
    </p>
    <div x-show="recovery" x-cloak>
      <output class="account-code" x-text="recovery"></output>
      <p class="account-note account-warning">{{ account_recovery_once }}</p>
      <button type="button" x-show="clipboard" x-cloak @click="copy(recovery)">{{ account_copy }}</button>
    </div>
    <button type="button" :disabled="busy" @click="make_recovery">
      <span x-show="!has_recovery" x-cloak>{{ account_recovery_make }}</span>
      <span x-show="has_recovery" x-cloak>{{ account_recovery_replace }}</span>
    </button>
  </fieldset>
  <fieldset x-show="!pending" x-cloak>
    <legend>{{ account_signin_legend }}</legend>
    <div class="field-row-stacked">
      <label for="account-code">{{ account_signin_label }}</label>
      <input
        id="account-code"
        type="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="40"
        x-model="code"
        @keydown.enter.prevent="sign_in"
      />
    </div>
    <p class="account-note" x-show="favorites_count > 0" x-cloak>{{ account_signin_merge }}</p>
    <button type="button" :disabled="busy || code.trim() === ''" @click="sign_in">{{ account_signin_button }}</button>
  </fieldset>
  <p class="account-message" aria-live="polite" x-show="message" x-cloak :class="{ failed }" x-text="message"></p>
  <div class="field-row account-actions">
    <button type="button" x-show="session && !pending" x-cloak :disabled="busy" @click="sign_out">{{ account_signout }}</button>
    <button type="button" @click="hide">{{ close }}</button>
  </div>
{% endcall %}
